# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database (PostgreSQL) - required for auth and jobs
DB_HOST=localhost
DB_PORT=5432
DB_NAME=textops
DB_USER=textops_user
DB_PASSWORD=textops_password

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Admin user: created on first start if not exists (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password-change-me

# CORS (allowed origin for frontend)
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
